# Tableau Cloud connection — get these from Tableau Cloud > Account Settings > Personal Access Tokens
# Server URL is your Tableau Cloud pod, e.g. https://10ay.online.tableau.com
TABLEAU_SERVER_URL=
# Site content URL (the URL-safe site name, NOT the display name)
TABLEAU_SITE_NAME=
# Personal Access Token name (displayed when you create the PAT)
TABLEAU_PAT_NAME=
# Personal Access Token secret (only shown once at creation — regenerate if lost)
TABLEAU_PAT_SECRET=

# Anthropic API key for Claude (claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=

# Slack incoming webhook URL for "Push to Slack" feature (Phase 3)
SLACK_WEBHOOK_URL=

# Backend server port (default: 3001)
PORT=3001

# Origin where the extension dev server runs (used for CORS allowlist)
EXTENSION_ORIGIN=http://localhost:5173
