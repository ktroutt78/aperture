<?xml version="1.0" encoding="utf-8"?>
<!--
  Aperture Copilot — Tableau Cloud Extension manifest (Phase 1 stub).

  Requirements from CLAUDE.md:
    - Declares `full data` permission (mandatory for Metadata/VizQL/Pulse fusion).
    - Minimum API version 1.4 (full data support).
    - Dashboard extension (not viz extension).

  Phase 1 status: STUB. This manifest is valid XML and declares the identity,
  permissions, and a dev-only source-location pointing at the Vite dev server.

  Phase 4/5 will refine: production URL, real icon, localized resources,
  final min-api-version bump if Phase 2 VizQL SSE requires 1.11+.
-->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.aperture.copilot" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Aperture — AI analytics co-pilot that fuses Tableau Metadata API, VizQL Data Service, and Pulse, streaming context-aware narrative intelligence through Claude without leaving the dashboard.</description>
    <author name="Aperture" email="" organization="Aperture" website="https://github.com/" />
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>http://localhost:5173/</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABAQMAAAAl21bKAAAAA1BMVEX///+nxBvIAAAAC0lEQVR4AWMAAQAABQABDQottAAAAABJRU5ErkJggg==</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Aperture Copilot</text>
    </resource>
  </resources>
</manifest>
